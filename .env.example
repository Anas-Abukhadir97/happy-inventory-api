# Development automatically creates an ignored local signing key under src/HappyInventory.Api/data/.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
# Production requires explicit secret settings and HTTPS at the API boundary.
# ConnectionStrings__Inventory=Data Source=/persistent/inventory.db
# BootstrapAdmin__Password=<strong unique password>
# Auth__SigningKey=<random secret of at least 32 UTF-8 bytes>
# Auth__Issuer=happy-inventory-api
# Auth__Audience=happy-inventory-clients
# Auth__BrowserOrigin=https://your-exact-public-origin.example
# EventLogs__Path=/persistent/private-logs
